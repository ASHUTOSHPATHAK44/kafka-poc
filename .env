# ---------------------------------------------------------------------------
# Pinned, mutually-compatible versions for the CDC -> Iceberg POC
# ---------------------------------------------------------------------------
# Spark 3.5.9  -> Scala 2.12, Java 17, bundled Python 3 (image-provided)
# Iceberg 1.10.1 -> iceberg-spark-runtime-3.5_2.12 + matching REST catalog image
# Spark 3.5.9's spark-sql-kafka-0-10 pins kafka-clients 3.4.1 (works with 3.9 broker)
# Debezium 3.6.3.Final -> Kafka Connect 3.1+, PostgreSQL 13-18, pgoutput plugin
# ---------------------------------------------------------------------------

POSTGRES_VERSION=16.10
KAFKA_VERSION=3.9.2
DEBEZIUM_VERSION=3.6.3.Final
KAFKA_UI_VERSION=v1.5.0

SPARK_VERSION=3.5.9
SCALA_BINARY_VERSION=2.12
ICEBERG_VERSION=1.10.1
KAFKA_CLIENTS_VERSION=3.4.1
COMMONS_POOL2_VERSION=2.11.1

# Last MinIO community release that still ships the full web console.
MINIO_VERSION=RELEASE.2025-04-22T22-12-26Z
MC_VERSION=RELEASE.2025-08-13T08-35-41Z

# --- Postgres -------------------------------------------------------------
POSTGRES_DB=inventory
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# --- MinIO / S3 -----------------------------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
ICEBERG_WAREHOUSE_BUCKET=warehouse
AWS_REGION=us-east-1

# --- Iceberg REST catalog metadata DB (lives in the same postgres container,
#     but a SEPARATE database from the CDC 'inventory' DB). Postgres handles
#     concurrent commits from multiple Spark streaming queries, unlike SQLite.
CATALOG_DB=iceberg_catalog
CATALOG_DB_USER=iceberg
CATALOG_DB_PASSWORD=iceberg
# PostgreSQL JDBC driver baked into the custom iceberg-rest image (the stock
# fixture image ships only the SQLite driver).
POSTGRES_JDBC_VERSION=42.7.4

# --- Airflow (orchestrates the batch consumer every 5 min) ----------------
AIRFLOW_VERSION=2.10.5
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
